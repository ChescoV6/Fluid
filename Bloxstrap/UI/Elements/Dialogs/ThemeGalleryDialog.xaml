<base:WpfUiWindow x:Class="Bloxstrap.UI.Elements.Dialogs.ThemeGalleryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:base="clr-namespace:Bloxstrap.UI.Elements.Base"
        Title="Theme gallery"
        Width="420"
        Height="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}">
    <Grid Margin="16,12,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Community bootstrapper themes" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <ListBox x:Name="ThemesListBox" Grid.Row="1" Margin="0,10,0,0" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="100" Margin="0,0,10,0" Content="Close" IsCancel="True" Click="Close_Click" />
            <ui:Button Width="100" Appearance="Primary" Content="Install" Click="Install_Click" />
        </StackPanel>
    </Grid>
</base:WpfUiWindow>
