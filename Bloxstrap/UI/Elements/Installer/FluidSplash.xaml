<Window x:Class="Bloxstrap.UI.Elements.Installer.FluidSplash"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:Bloxstrap.UI.Elements.Controls"
        Title="Fluid"
        Width="440" Height="300"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Border CornerRadius="18" Background="{ui:ThemeResource ApplicationBackgroundBrush}" BorderThickness="1" BorderBrush="#2660CDFF">
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" ShadowDepth="0" Opacity="0.4" Color="#085CC4" />
        </Border.Effect>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <controls:FluidMark Width="96" Height="96" HorizontalAlignment="Center" />
            <TextBlock Text="Fluid" FontSize="34" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="A custom bootstrapper for Roblox" FontSize="13" HorizontalAlignment="Center" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ProgressBar Width="170" Height="4" Margin="0,24,0,0" IsIndeterminate="True" Foreground="{DynamicResource FluidMarkGradient}" BorderThickness="0" />
        </StackPanel>
    </Border>
</Window>
