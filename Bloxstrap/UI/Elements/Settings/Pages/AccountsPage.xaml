<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.AccountsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="500" d:DesignWidth="800"
      Title="AccountsPage"
      Scrollable="True"
      Loaded="Page_Loaded">
    <StackPanel Margin="0,0,14,14">
        <TextBlock Margin="0,0,0,4" Text="Save multiple Roblox accounts and switch between them." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <TextBlock Margin="0,0,0,16" Text="Switching writes the selected account into Roblox's session store — it takes effect the next time Roblox starts. Tokens are encrypted per-Windows-user." FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

        <ui:CardAction Icon="PersonAdd24" Margin="0,4,0,0" Click="AddCurrent_Click">
            <StackPanel>
                <TextBlock FontSize="14" Text="Add current account" />
                <TextBlock Margin="0,2,0,0" FontSize="12" Padding="0,0,16,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Requires 'Allow cookie access' to be enabled and Roblox to have been launched at least once." />
            </StackPanel>
        </ui:CardAction>

        <StackPanel x:Name="AccountListPanel" Margin="0,12,0,0" />
    </StackPanel>
</ui:UiPage>
