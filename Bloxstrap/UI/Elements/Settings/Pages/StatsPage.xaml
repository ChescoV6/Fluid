<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.StatsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="500" d:DesignWidth="800"
      Title="StatsPage"
      Scrollable="True"
      Loaded="Page_Loaded">
    <StackPanel Margin="0,0,14,14">
        <TextBlock Margin="0,0,0,16" Text="Local statistics collected while activity tracking is enabled." FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <ui:Card Padding="14,12" Margin="0,4,0,8">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,32,0">
                    <TextBlock Text="Sessions" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="SessionCountText" FontSize="24" FontWeight="SemiBold" Text="0" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Total playtime" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock x:Name="TotalTimeText" FontSize="24" FontWeight="SemiBold" Text="0m" />
                </StackPanel>
            </StackPanel>
        </ui:Card>

        <TextBlock Text="Most played" FontSize="20" FontWeight="Medium" Margin="0,16,0,0" />
        <StackPanel x:Name="TopGamesPanel" Margin="0,8,0,0" />

        <ui:Button Margin="0,16,0,0" Content="Export sessions to CSV" Icon="ArrowExportLtr24" Click="ExportCsv_Click" HorizontalAlignment="Left" />
    </StackPanel>
</ui:UiPage>
